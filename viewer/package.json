{
  "name": "walkpad-insole-viewer",
  "version": "3.50.0",
  "private": true,
  "description": "鞋垫数据查看器：本地 zip / parquet / 维特 TXT 的压力与 IMU 波形分析",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "test": "node tests/axis-offline.mjs && node tests/heading.mjs && node tests/squat-axis.mjs && node tests/ankle-clock.mjs && node tests/pack-video.mjs && node tests/interaction.mjs",
    "test:activity": "node tests/activity.mjs",
    "test:axis": "node tests/axis-offline.mjs",
    "test:heading": "node tests/heading.mjs",
    "test:squat-axis": "node tests/squat-axis.mjs",
    "test:ankle-clock": "node tests/ankle-clock.mjs",
    "test:activity-browser": "node tests/activity-browser.mjs",
    "test:squat-score": "node tests/squat-score-features.mjs && node tests/squat-score-model.mjs",
    "test:b1": "node tests/b1.mjs",
    "test:b1q": "node tests/b1.mjs b1q",
    "test:pack-video": "node tests/pack-video.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "fzstd": "^0.1.1",
    "hyparquet": "^1.33.0",
    "mediabunny": "1.66.2"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.7"
  }
}
